# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Flask
FLASK_ENV=development            # development | production
SECRET_KEY=ganti-dengan-string-acak-panjang   # python -c "import secrets;print(secrets.token_hex(32))"
SESSION_COOKIE_SECURE=false      # true jika di-serve lewat HTTPS

# Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=railway
DB_PORT=3306
DB_CONNECT_TIMEOUT=10

# App
APP_NAME=CV. Twin Anugrah Jaya
PER_PAGE_DEFAULT=10
UPLOAD_FOLDER=                   # kosong = app/uploads
MAX_UPLOAD_MB=5
